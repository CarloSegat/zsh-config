xGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pin53" target="end54"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.3958333333333333;exitY=1;exitDx=0;exitDy=0;entryX=0.17316017316017315;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="obj37" target="frame39"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="obj69" value="&lt;b&gt;Phase 2 output — one entry per thread / worktree&lt;/b&gt;&lt;br&gt;[&lt;br&gt;&amp;nbsp;&amp;nbsp;{ &quot;branch&quot;: &quot;dumb/&amp;lt;task&amp;gt;-&amp;lt;thread&amp;gt;&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;worktree&quot;: &quot;$SP/dumb-loop/wt/&amp;lt;thread&amp;gt;&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;commits&quot;: [&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// one per unit, in plan order&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;subject&quot;: &quot;type(nick)&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// fixed by the plan&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;title&quot;: …, &quot;body&quot;: … }&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// the executor&#x27;s own account&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;reports&quot;: [&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// one per unit&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;unit&quot;: 1, &quot;status&quot;: &quot;done | stopped: &amp;lt;reason&amp;gt;&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;check_tail&quot;: &quot;&amp;lt;last 10 lines of the check output&amp;gt;&quot; }&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;halted_at&quot;: null | &amp;lt;unit&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// stopped → finding&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontFamily=Courier New;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1970" width="480" height="209" as="geometry"/></mxCell><mxCell id="e70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.17316017316017315;exitY=1;exitDx=0;exitDy=0;entryX=0.3958333333333333;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame39" target="obj69"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="frame71" value="Phase 3 — Mechanical merge" style="shape=umlFrame;whiteSpace=wrap;html=1;width=230;height=30;fillColor=none;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="2209" width="515" height="678" as="geometry"/></mxCell><mxCell id="reg72" value="&lt;b&gt;«iterative»&lt;/b&gt; for each thread / worktree" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=208;spacingTop=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="2309" width="475" height="376" as="geometry"/></mxCell><mxCell id="start73" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="2259" width="20" height="20" as="geometry"/></mxCell><mxCell id="pin74" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="2309" width="36" height="12" as="geometry"/></mxCell><mxCell id="r75" value="Check the thread: is the worktree clean,&lt;br&gt;one commit per planned unit, in order?&lt;br&gt;Anything off is a finding — merge anyway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2349" width="300" height="78" as="geometry"/></mxCell><mxCell id="r76" value="Merge the thread branch into the task&lt;br&gt;branch with --no-ff, never squash.&lt;br&gt;A conflict is a finding:&lt;br&gt;the file lists overlapped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2473" width="300" height="78" as="geometry"/></mxCell><mxCell id="r77" value="Delete the thread&#x27;s worktree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2597" width="300" height="40" as="geometry"/></mxCell><mxCell id="pin78" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="2673" width="36" height="12" as="geometry"/></mxCell><mxCell id="d79" value="Threads left for&lt;br&gt;a later wave?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="2733" width="240" height="70" as="geometry"/></mxCell><mxCell id="end80" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="218" y="2843" width="24" height="24" as="geometry"/></mxCell><mxCell id="note81" value="Nobody reads the code here; Phase 4 does." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=8;fillColor=#a6e3a1;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="392" y="2361" width="130" height="52" as="geometry"/></mxCell><mxCell id="note82" value="A wave = the threads whose dependencies are all merged. Wave 2 on branches off the task branch, not main." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=8;fillColor=#a6e3a1;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="2731" width="165" height="74" as="geometry"/></mxCell><mxCell id="e83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start73" target="pin74"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pin74" target="r75"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r75" target="r76"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCe