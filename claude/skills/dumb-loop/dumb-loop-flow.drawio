="e36"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="obj37" value="&lt;b&gt;plans/&amp;lt;task&amp;gt;.md — Phase 1 output, Phase 2 input&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;task&quot;: …, &quot;repo&quot;: …, &quot;guide&quot;: …, &quot;import&quot;: …, &quot;check&quot;: …, &quot;e2e&quot;: …,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;branch&quot;: &quot;dumb/&amp;lt;task&amp;gt;&quot;, &quot;disjoint&quot;: &quot;yes&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;// per the lint&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;backlog_text&quot;: &quot;&amp;lt;copied verbatim&amp;gt;&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;threads&quot;: [&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ≤5 per wave&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;name&quot;: …, &quot;files&quot;: [ exclusive list ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;depends_on&quot;: [ thread numbers ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;steps&quot;: [&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ≤8 code steps&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;1&quot;:&amp;nbsp;&amp;nbsp;&quot;&amp;lt;file&amp;gt;: exact change. Pattern: &amp;lt;file:symbol&amp;gt;&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp