ell id="start42" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="1206" width="20" height="20" as="geometry"/></mxCell><mxCell id="r43" value="Branch off main. Give each thread&lt;br&gt;a worktree; refresh its engine cache." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="1256" width="280" height="64" as="geometry"/></mxCell><mxCell id="pin44" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="1352" width="36" height="12" as="geometry"/></mxCell><mxCell id="pin45" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="1392" width="36" height="12" as="geometry"/></mxCell><mxCell id="r46" value="Hand this unit to a local model.&lt;br&gt;Unit 1 of every thread goes out at once.&lt;br&gt;Later units only get the commit log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="1436" width="280" height="64" as="geometry"/></mxCell><mxCell id="r47" value="Edit only the listed files. Run the check,&lt;br&gt;paste its last 10 lines, then commit.&lt;br&gt;Check fails twice? Stop and say so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1436" width="300" height="64" as="geometry"/></mxCell><mxCell id="r48" value="Look at the worktree yourself,&lt;br&gt;not at what the model says it did." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="1546" width="280" height="64" as="geometry"/></mxCell><mxCell id="d49" value="Did it really commit the unit&lt;br&gt;and show the check passing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1656" width="260" height="80" as="geometry"/></mxCell><mxCell id="r50" value="No commit, or no proof the check passed: stop this thread here. Its earlier commits stay. Log it as a finding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="1652" width="160" height="88" as="geometry"/></mxCell><mxCell id="ff51" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="1772" width="24" height="24" as="geometry"/></mxCell><mxCell id="pin52" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="1816" width="36" height="12" as="geometry"/></mxCell><mxCell id="pin53" value="" style="shape=process;size=0.333;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="212" y="1852" width="36" height="12" as="geometry"/></mxCell><mxCell id="end54" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="218" y="1896" width="24" height="24" as="geometry"/></mxCell><mxCell id="note55" value="One unit in flight per thread,&lt;br&gt;so 5 threads = 5 gateway requests." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=8;fillColor=#a6e3a1;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="1556" width="240" height="40" as="geometry"/></mxCell><mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;e