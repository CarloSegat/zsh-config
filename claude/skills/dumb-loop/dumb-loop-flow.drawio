nalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.025510204081632654;entryDx=0;entryDy=0;" edge="1" parent="1" source="d79" target="frame39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="2768"/><mxPoint x="20" y="1176"/></Array></mxGeometry></mxCell><mxCell id="e91l" value="yes —&lt;br&gt;next wave" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontFamily=Helvetica;fontSize=11;" vertex="1" connectable="0" parent="e91"><mxGeometry x="-1" y="0" relative="1" as="geometry"><mxPoint x="-42" y="-16" as="offset"/></mxGeometry></mxCell><mxCell id="frame92" value="Phase 4 — Review" style="shape=umlFrame;whiteSpace=wrap;html=1;width=170;height=30;fillColor=none;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="2927" width="1540" height="944" as="geometry"/></mxCell><mxCell id="start93" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="2977" width="20" height="20" as="geometry"/></mxCell><mxCell id="r94" value="Add a review worktree on the task branch;&lt;br&gt;refresh its engine cache." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="3027" width="300" height="64" as="geometry"/></mxCell><mxCell id="r95" value="Verify thread: run the check, every e2e&lt;br&gt;suite and the lint. Paste the last 10 lines&lt;br&gt;of each and the whole lint output.&lt;br&gt;A failed suite or a lint line is a finding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="3127" width="295" height="92" as="geometry"/></mxCell><mxCell id="r96" value="3 critics, read-only, each given the plan,&lt;br&gt;the thread reports and git show per commit:&lt;br&gt;does each commit do what its unit said?&lt;br&gt;Does its message match its diff? Any bugs?&lt;br&gt;≤10 findings each." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="3127" width="295" height="106" as="geometry"/></mxCell><mxCell id="r97" value="Cross-judge dedupes and ranks them:&lt;br&gt;≤10 findings → review-findings.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="3263" width="295" height="52" as="geometry"/></mxCell><mxCell id="r98" value="Read review-findings.md and only the hunks&lt;br&gt;it cites. Never the whole diff." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="3377" width="300" height="64" as="geometry"/></mxCell><mxCell id="r99" value="Put each finding in one bucket:&lt;br&gt;GODOT, skill, unpreventable, rule failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="3487" width="300" height="52" as="geometry"/></mxCell><mxCell id="note100" value="GODOT — an engine mistake a rule could prevent&lt;br&gt;skill — the plan was ambiguous or incomplete&lt;br&gt;unpreventable — no rule would have caught it&lt;br&gt;rule failed — round 2 only: a round-1 rule didn&#x27;t hold" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=8;fillColor=#a6e3a1;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="585" y="3473" width="330" height="80" as="geometry"/></mxCell><mxCell id="d101" value="Would this round&lt;br&gt;merge into main?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetic