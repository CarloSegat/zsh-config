{
  "suggest.noselect": true,
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "svelte.enable-ts-plugin": true,
  "languageserver": {
    "go": {
      "command": "gopls",
      "rootPatterns": ["go.work", "go.mod", ".vim/", ".git/", ".hg/"],
      "filetypes": ["go"],
      "initializationOptions": {
        "usePlaceholders": true
      }
    }
  }
}
